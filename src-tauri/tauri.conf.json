{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScreenTrans",
  "version": "0.2.34",
  "identifier": "com.screen-trans.screentrans",
  "build": {
    "beforeDevCommand": "python dev_server.py",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "ScreenTrans",
        "width": 520,
        "height": 480,
        "resizable": true,
        "center": true,
        "minWidth": 360,
        "minHeight": 220,
        "decorations": true,
        "shadow": true,
        "backgroundColor": "#111111",
        "theme": "Dark",
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "targets": "all"
  },
  "plugins": {
    "global-shortcut": null,
    "autostart": null
  },
  "mainBinaryName": "ScreenTrans"
}
